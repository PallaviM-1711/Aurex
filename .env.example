# Copy this file to .env.local and fill in the values you need.
# .env.local is gitignored — never commit real secrets.

# Required to deploy or verify contracts.
PRIVATE_KEY=

# Required only for source verification on MSTScan.
MSTSCAN_API_KEY=

# Optional — enables WalletConnect in the frontend. Get one at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
