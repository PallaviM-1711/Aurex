# ==========================================
# AUREX AI PLATFORM - ENVIRONMENT VARIABLES
# ==========================================

# System Mode
NODE_ENV=development
PORT=5000
DEMO_MODE=true

# Database (MongoDB connection string, or falls back seamlessly to in-memory store if unreachable)
MONGODB_URI=mongodb://localhost:27017/aurex_ai

# Security & Authentication
JWT_SECRET=aurex_super_secret_jwt_key_9999_change_in_production
JWT_EXPIRES_IN=7d

# Aurex Payment Gateway Integration
AUREX_API_URL=https://api.aurexpay.com/v1
AUREX_API_KEY=aurex_live_sec_example_key_do_not_commit
AUREX_MERCHANT_ID=merch_aurex_ai_001
AUREX_WEBHOOK_SECRET=whsec_aurex_mock_secret

# AI Providers (Gemini / OpenAI / Anthropic)
AI_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=

# File Storage & Limits
MAX_FILE_SIZE_MB=25
UPLOAD_DIR=./uploads

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:3000

# Frontend Environment Variables (apps/web/.env)
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_APP_NAME="Aurex AI"
NEXT_PUBLIC_DEMO_MODE=true
