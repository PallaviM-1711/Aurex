# The `my-mst-project-shared` workspace package is what actually keeps
# pnpm from resolving to a same-named registry package: create-mst-app
# writes it into packages/frontend/package.json with the `workspace:`
# protocol on pnpm projects, which pnpm always resolves locally regardless
# of this setting. This is a general-purpose second line of defense for any
# other workspace-to-workspace dependency added later with a plain semver
# range. Ignored by npm/yarn.
link-workspace-packages=true
